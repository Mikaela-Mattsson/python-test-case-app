@startuml classdiagram
title Testregister

skinparam classAttributeIconSize 0

class TestCase {
    +id : str
    +title : str
    +data : str
    +steps : TestSteps[1..*]
    +actual_result : ActualResult
}

class TestSteps {
    +instructions : str
    +expected_result : str
}

class ActualResult {
    +status : str
    +actual_result : str
    +approved : bool
}

class TestCaseService {
    -repository : TestCaseRepository
    +try_add_test_case(test_case : TestCase) : None
    +delete_test_case (test_case : TestCase) : None
    +update_test_case (test_case : TestCase) : None
    +get_all_test_cases() : TestCase[0..*]
}

class TestCaseRepository {
    +try_add(test_case : TestCase) : None
    +get_all() : TestCase[0..*]
    +delete(test_case : TestCase) : void
    +update(test_case : TestCase) : void
}

class TestCaseDialogs {
    -service : TestCaseService
    +create_test_case() :None
    +delete_test_case() :None
    +update_test_case() :None
    +show_test_cases() :None
    +show_menu() : None
}

TestCase ..> TestSteps: <<uses>>
TestCase ..> ActualResult: <<uses>>
TestCaseService ..> TestCase: <<uses>>
TestCaseRepository ..> TestCase: <<uses>>
TestCaseService ..> TestCaseRepository: <<depends>>
TestCaseDialogs ..> TestCaseService : <<uses>>

@enduml